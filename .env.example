# URL backend API. BẮT BUỘC ở production — frontend KHÔNG có chế độ mock/giả lập lúc chạy.
# Bỏ trống chỉ được chấp nhận cho build không có API (CI/static): khi đó cờ `isApiConfigured`
# (lib/api/client.ts) chỉ bỏ prerender SSG cây `/[locale]` + sitemap, KHÔNG bật dữ liệu mock.
# Thiếu biến này ở runtime → base URL rỗng, mọi lời gọi API hỏng (không có fallback).
# Tiền tố NEXT_PUBLIC_ để Next inline vào cả bundle trình duyệt (contact form, search gọi client).
# Production (Vercel): đặt bằng URL Render + /api, ví dụ:
#   https://thien-duc-website-backend.onrender.com/api
NEXT_PUBLIC_API_URL=

# URL công khai của site — dùng cho canonical & JSON-LD (breadcrumb SEO).
# Production (Vercel): đặt bằng domain thật, ví dụ https://thien-duc-website-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=

# Sentry error tracking (task →5) — DSN của project Sentry riêng cho frontend (tùy chọn).
# DSN là khóa ingest-only, an toàn để nằm trong bundle client (không phải secret).
# Bỏ trống → không init, site chạy bình thường.
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Upload source map lên Sentry (backlog §6) — CHỈ đặt ở môi trường build
# (Vercel / GitHub Actions), KHÔNG commit giá trị vào repo.
#
# Phải có ĐỦ CẢ BA thì build mới upload; thiếu bất kỳ cái nào thì bỏ qua và
# build vẫn xanh (xem `src/lib/sentry-build.ts` + `next.config.ts`).
# Token cần scope `project:releases`; tạo ở Sentry → Settings → Auth Tokens.
# ---------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Tùy chọn — định danh release. Bỏ trống thì lấy VERCEL_GIT_COMMIT_SHA hoặc
# GITHUB_SHA. Nên là SHA commit để map đúng bundle ↔ mã nguồn.
SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# TÙY CHỌN — hợp đồng build nghiêm ngặt (`src/lib/api/client.ts`).
#
# BUILD_REQUIRE_API=1 → lỗi gọi API lúc build làm BUILD ĐỎ thay vì degrade.
# Bỏ trống (mặc định) → backend không phản hồi thì bỏ prerender, trang vẫn
# render on-demand lúc chạy, build vẫn xanh.
#
# KHÔNG bật trên Vercel production nếu chưa chắc backend luôn sẵn sàng lúc
# build: backend Render Free ngủ sau 15 phút, trúng lúc ngủ là hỏng deploy.
# Chỉ nên bật ở pipeline tự dựng sẵn backend.
#
# ⚠️ Lưu ý độc lập với cờ này: `src/app/sitemap.ts` KHÔNG bọc try/catch, nên khi
# NEXT_PUBLIC_API_URL đã đặt mà backend không phản hồi thì `/sitemap.xml` làm
# hỏng build dù BUILD_REQUIRE_API để trống. Deploy backend trước frontend.
# ---------------------------------------------------------------------------
BUILD_REQUIRE_API=
